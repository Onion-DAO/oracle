# Lint before committing: errors block the commit, warnings are only shown
cd functions || exit 1

if ! lint_outcome=$( npm run --silent lint:check 2>&1 ); then
    echo "🚨 [ precommit hook ] lint found blocking issues, fix them before committing"
    echo "$lint_outcome"
    exit 1
fi

if echo "$lint_outcome" | grep -q "warning"; then
    echo "⚠️ [ precommit hook ] lint found warnings, consider fixing them (npm run lint)"
    echo "$lint_outcome"
fi
